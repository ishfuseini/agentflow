# --- LLM providers (model routing: cost vs intelligence) ---
# OpenRouter API key — used for the intelligence-tier model (Architect Agent, claude-opus-4-8)
OPENROUTER_API_KEY=
# Ollama Cloud API key — used for the cost-tier model (gpt-oss:20b)
OLLAMA_CLOUD_API_KEY=

# --- Langfuse tracing (dedicated project for agentflow) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Base URL of the Langfuse instance this app reports to
LANGFUSE_BASE_URL=

# --- agentflow-mcp server ---
# Remote (Fly.io) MCP endpoint. For local dev, use stdio transport via MCP Inspector instead.
AGENTFLOW_MCP_URL=https://agentflow-mcp.fly.dev/mcp

# NOTE: BRANDFETCH_API_KEY, LOGO_DEV_SECRET_KEY, and LOGO_DEV_PUBLISHABLE_KEY are
# consumed by the agentflow-mcp server, NOT by this app. Do not configure them here.
