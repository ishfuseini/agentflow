# --- LLM providers (model routing: cost vs intelligence) ---
# OpenRouter API key — used for the intelligence-tier model (Architect Agent, claude-opus-4-8)
OPENROUTER_API_KEY=
# Ollama Cloud API key — used for the cost-tier model (gpt-oss:20b)
OLLAMA_CLOUD_API_KEY=
# No longer required for tracing. The OpenAI Agents SDK's default OpenAI
# tracing exporter (which logged "No API key provided for OpenAI tracing
# exporter") is replaced at server boot with a Langfuse OTLP exporter in
# src/lib/pipeline/agents-tracing.ts. Kept as a harmless placeholder since
# the OpenAI client may still warn if instantiated without a key.
OPENAI_API_KEY=sk-dummy
# Optional Ollama-compatible endpoint/model overrides. Defaults: https://ollama.com/v1 and gpt-oss:20b
OLLAMA_ENDPOINT=
OLLAMA_MODEL=

# --- Langfuse tracing (dedicated project for agentflow) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Base URL of the Langfuse instance this app reports to
LANGFUSE_BASE_URL=
# Optional trace dimensions for Langfuse v4/OTEL ingestion
LANGFUSE_TRACING_ENVIRONMENT=
LANGFUSE_RELEASE=

# --- HITL pending state ---
# Persistent store path for paused HITL runs; use a shared mount in multi-instance deployments.
HITL_PENDING_STORE_PATH=.data/hitl-pending-runs.json

# --- agentflow-mcp server ---
# Remote (Fly.io) MCP endpoint. For local dev, use stdio transport via MCP Inspector instead.
AGENTFLOW_MCP_URL=https://agentflow-mcp.fly.dev/mcp

# NOTE: BRANDFETCH_API_KEY, LOGO_DEV_SECRET_KEY, and LOGO_DEV_PUBLISHABLE_KEY are
# consumed by the agentflow-mcp server, NOT by this app. Do not configure them here.
